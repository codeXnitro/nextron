{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "electron",
    "rootDir": "electron",
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "allowJs": false
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/types.d.ts", "node_modules"]
}
